{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recognition.event.v2",
  "title": "Recognition event / receipt (v2) — Handoff §11, §12",
  "description": "One hash-chained record in an append-only timeline (events, history, identity receipts). event_hash = SHA-256 of the canonical JSON of the record minus event_hash; prev_hash links to the predecessor (genesis = 64 zeros).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","event_id","seq","ts_utc","type","identity","prev_hash","event_hash"],
  "properties": {
    "schema":     { "const": "recognition.event.v2" },
    "event_id":   { "type": "string", "pattern": "^evt-[0-9]{6}$" },
    "seq":        { "type": "integer", "minimum": 1 },
    "ts_utc":     { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "type":       { "type": "string", "minLength": 1 },
    "tab_id":     { "type": ["string","null"] },
    "data":       { "type": ["object","array","string","number","boolean","null"] },
    "identity": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": { "type": "string" },
        "profile":    { "type": "string" },
        "device":     { "type": "string" }
      }
    },
    "prev_hash":  { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "event_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

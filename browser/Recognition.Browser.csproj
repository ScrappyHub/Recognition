<Project Sdk="Microsoft.NET.Sdk">

  <!-- WBS 5.1 — Recognition governed browser shell (WebView2 / WPF).
       Build: pwsh -File browser\build.ps1   (needs .NET 8 SDK + WebView2 Runtime) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RecognitionBrowser</AssemblyName>
    <RootNamespace>Recognition.Browser</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- WBS 5.1 — Recognition governed browser shell (WebView2 / WPF).
       Build: pwsh -File browser\build.ps1   (needs .NET 8 SDK + WebView2 Runtime) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RecognitionBrowser</AssemblyName>
    <RootNamespace>Recognition.Browser</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>recognition.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Product>Recognition</Product>
    <Company>ScrappyHub</Company>
    <Description>Recognition governed browser</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
    <!-- Windows DPAPI (per-user at-rest encryption for history/bookmarks/downloads) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Offline PDF page tools (extract/merge/split/rotate/reorder). MIT license, pinned version. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- window icon (pack URI) -->
    <Resource Include="recognition.ico" />
    <!-- fingerprint shield script, injected into every web page before its own scripts run -->
    <EmbeddedResource Include="shield\fingerprint_shield.js" LogicalName="fingerprint_shield.js" />
    <EmbeddedResource Include="shield\passkey_guard.js" LogicalName="passkey_guard.js" />
    <EmbeddedResource Include="shield\passkey_test.js" LogicalName="passkey_test.js" />
  </ItemGroup>

</Project>

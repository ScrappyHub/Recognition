<Window x:Class="Recognition.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recognition — Governed Browser" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- chrome -->
      <RowDefinition Height="*"/>      <!-- tabs + find + web content -->
      <RowDefinition Height="Auto"/>   <!-- status -->
    </Grid.RowDefinitions>

    <!-- Chrome: nav + address + actions -->
    <Border Grid.Row="0" Background="#1B1E24" BorderBrush="#2A2E36" BorderThickness="0,0,0,1">
      <Grid Margin="8,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BackBtn"   Grid.Column="0" Content="&#x25C0;" ToolTip="Back (Alt+Left)"     Click="Back_Click"    Style="{StaticResource NavBtn}"/>
        <Button x:Name="FwdBtn"    Grid.Column="1" Content="&#x25B6;" ToolTip="Forward (Alt+Right)" Click="Forward_Click" Style="{StaticResource NavBtn}"/>
        <Button x:Name="ReloadBtn" Grid.Column="2" Content="&#x27F3;" ToolTip="Reload (Ctrl+R)"     Click="Reload_Click"  Style="{StaticResource NavBtn}"/>

        <Border x:Name="AddrBorder" Grid.Column="3" Background="#0E1015" BorderBrush="#2E333C" BorderThickness="1" CornerRadius="7" Margin="8,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#128274;" Foreground="#6FCF97" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"/>
            <TextBox x:Name="AddressBar" Grid.Column="1" Background="Transparent" Foreground="#E8E8E8"
                     BorderThickness="0" VerticalContentAlignment="Center" Padding="8,7" CaretBrush="#E8E8E8"
                     FontSize="13" KeyDown="Address_KeyDown" TextChanged="Address_TextChanged"
                     GotKeyboardFocus="Address_GotFocus" LostKeyboardFocus="Address_LostFocus"/>
            <Button x:Name="ShieldBtn" Grid.Column="2" Content="&#x1F6E1;" ToolTip="Trackers &amp; ads blocked — click for settings"
                    Foreground="#6FCF97" Background="Transparent" BorderThickness="0" FontSize="13"
                    Padding="6,0" Cursor="Hand" Click="Shield_Click"/>
            <Button x:Name="StarBtn" Grid.Column="3" Content="&#x2606;" ToolTip="Bookmark this page (Ctrl+D)"
                    Foreground="#C7CCD4" Background="Transparent" BorderThickness="0" FontSize="15"
                    Padding="8,0" Cursor="Hand" Click="Star_Click"/>
          </Grid>
        </Border>

        <Button x:Name="GoBtn"     Grid.Column="4" Content="Go"       Click="Go_Click"     Style="{StaticResource NavBtn}"/>
        <Button x:Name="NewTabBtn" Grid.Column="5" Content="&#x2795;" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" Style="{StaticResource NavBtn}"/>
        <Button x:Name="MenuBtn"   Grid.Column="6" Content="&#x2630;" ToolTip="Menu"       Click="Menu_Click"   Style="{StaticResource NavBtn}">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="New tab"   Click="MenuNewTab_Click"   InputGestureText="Ctrl+T"/>
              <Separator/>
              <MenuItem Header="Bookmarks" Click="MenuBookmarks_Click"/>
              <MenuItem Header="History"   Click="MenuHistory_Click"/>
              <MenuItem Header="Downloads" Click="MenuDownloads_Click"/>
              <MenuItem Header="Find in page" Click="MenuFind_Click"  InputGestureText="Ctrl+F"/>
              <Separator/>
              <MenuItem Header="Zoom in"    Click="MenuZoomIn_Click"  InputGestureText="Ctrl++"/>
              <MenuItem Header="Zoom out"   Click="MenuZoomOut_Click" InputGestureText="Ctrl+-"/>
              <MenuItem Header="Reset zoom" Click="MenuZoomReset_Click" InputGestureText="Ctrl+0"/>
              <Separator/>
              <MenuItem Header="Settings"  Click="MenuSettings_Click"/>
              <MenuItem Header="Export Session (governed packet)" Click="Export_Click"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button x:Name="ExportBtn" Grid.Column="7" Content="Export Session" ToolTip="Export a governed evidence packet"
                Click="Export_Click" Style="{StaticResource AccentBtn}"/>
      </Grid>
    </Border>

    <!-- Tab strip + find bar over a persistent web host -->
    <DockPanel Grid.Row="1" LastChildFill="True">
      <TabControl x:Name="Tabs" DockPanel.Dock="Top" Background="#15181D" BorderThickness="0"
                  SelectionChanged="Tabs_SelectionChanged">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Background="#15181D">
              <TabPanel IsItemsHost="True" Margin="4,4,4,0"/>
            </ScrollViewer>
          </ControlTemplate>
        </TabControl.Template>
      </TabControl>

      <Border x:Name="FindBar" DockPanel.Dock="Top" Background="#1B1E24" BorderBrush="#2A2E36"
              BorderThickness="0,0,0,1" Visibility="Collapsed" Padding="8,5">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Find:" Foreground="#B8BDC7" VerticalAlignment="Center" Margin="2,0,8,0" FontSize="12"/>
          <Border Background="#0E1015" BorderBrush="#2E333C" BorderThickness="1" CornerRadius="6" Width="280">
            <TextBox x:Name="FindBox" Background="Transparent" Foreground="#E8E8E8" BorderThickness="0"
                     VerticalContentAlignment="Center" Padding="8,5" CaretBrush="#E8E8E8" FontSize="12"
                     KeyDown="FindBox_KeyDown"/>
          </Border>
          <Button Content="&#x25B2;" ToolTip="Previous (Shift+Enter)" Click="FindPrev_Click" Style="{StaticResource NavBtn}" Margin="6,0,0,0"/>
          <Button Content="&#x25BC;" ToolTip="Next (Enter)"           Click="FindNext_Click" Style="{StaticResource NavBtn}"/>
          <Button Content="&#x2715;" ToolTip="Close (Esc)"            Click="FindClose_Click" Style="{StaticResource NavBtn}" Margin="6,0,0,0"/>
        </StackPanel>
      </Border>

      <Grid x:Name="WebHost" Background="#1E1F22"/>
    </DockPanel>

    <!-- Status strip -->
    <Border Grid.Row="2" Background="#1B1E24" BorderBrush="#2A2E36" BorderThickness="0,1,0,0">
      <Grid Margin="10,4">
        <TextBlock x:Name="StatusText" Foreground="#B8BDC7" FontSize="12" Text="starting…" HorizontalAlignment="Left"/>
        <TextBlock x:Name="GovText" Foreground="#6FCF97" FontSize="12" HorizontalAlignment="Right"
                   Text="governed • HTTPS-first • no autofill • no telemetry"/>
      </Grid>
    </Border>

    <!-- Omnibox suggestions (floats; not part of grid flow) -->
    <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=AddrBorder}" Placement="Bottom"
           AllowsTransparency="True" StaysOpen="False" Focusable="False"
           HorizontalOffset="0" VerticalOffset="2">
      <Border Background="#14171C" BorderBrush="#2E333C" BorderThickness="1" CornerRadius="8"
              MinWidth="{Binding ActualWidth, ElementName=AddrBorder}" Padding="4">
        <ListBox x:Name="SuggestList" Background="Transparent" BorderThickness="0" MaxHeight="320"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonUp="Suggest_Click">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="8,6"/>
              <Setter Property="Foreground" Value="#E4E7EC"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#26456E"/></Trigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#20242C"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icon}" Foreground="#7F8794" Width="20" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="{Binding Primary}" Foreground="#E8E8E8" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="820"/>
                  <TextBlock Text="{Binding Secondary}" Foreground="#6D7480" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="820"/>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Popup>

  </Grid>
</Window>

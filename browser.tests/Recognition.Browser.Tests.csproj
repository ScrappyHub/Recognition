<Project Sdk="Microsoft.NET.Sdk">

  <!-- Executes the browser's REAL governance code (GovernedActions), compiled from the very same
       source file the browser uses, against golden vectors and negative vectors. No WPF or WebView2
       dependency. Run with: dotnet run (project browser.tests, configuration Release).
       Token on success: SELFTEST_RECOGNITION_BROWSER_GOVERNED_ACTIONS_V1_OK -->

  <!-- NOTE: an XML comment may not contain two consecutive hyphens. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Recognition.Browser.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\browser\GovernedActions.cs" Link="GovernedActions.cs" />
    <Compile Include="..\browser\Appearance.cs" Link="Appearance.cs" />
    <Compile Include="..\browser\NetworkInfo.cs" Link="NetworkInfo.cs" />
    <Compile Include="..\browser\SetupSnapshot.cs" Link="SetupSnapshot.cs" />
    <Compile Include="..\browser\PasswordVault.cs" Link="PasswordVault.cs" />
    <Compile Include="..\browser\PrivacyRules.cs" Link="PrivacyRules.cs" />
    <Compile Include="..\browser\CodeHighlighter.cs" Link="CodeHighlighter.cs" />
    <Compile Include="..\browser\PdfTools.cs" Link="PdfTools.cs" />
    <Compile Include="..\browser\ImageMath.cs" Link="ImageMath.cs" />
    <Compile Include="..\browser\SafetyRules.cs" Link="SafetyRules.cs" />
    <Compile Include="..\browser\FilterEngine.cs" Link="FilterEngine.cs" />
    <Compile Include="..\browser\ImagePdf.cs" Link="ImagePdf.cs" />
    <Compile Include="..\browser\ExtensionGovernance.cs" Link="ExtensionGovernance.cs" />
    <Compile Include="..\browser\RuntimeCheck.cs" Link="RuntimeCheck.cs" />
    <!-- Pinned. PDFsharp is MIT-licensed and has no native or Windows-only dependencies. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
